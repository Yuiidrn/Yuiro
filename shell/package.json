{
  "name": "yuiro-shell",
  "version": "0.1.0",
  "description": "Yuiro Electron + Vue3 (TypeScript) desktop pet shell",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "vue-tsc --noEmit",
    "build:win": "electron-vite build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac --arm64"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.1",
    "@vueuse/core": "^11.3.0",
    "animejs": "^4.5.0",
    "dompurify": "^3.4.17",
    "live2dcubismcore": "^1.0.2",
    "marked": "^18.1.1",
    "pinia": "^2.3.0",
    "pixi-live2d-display": "0.5.0-beta",
    "pixi.js": "^7.4.3",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@iconify-json/solar": "^1.2.6",
    "@types/animejs": "^3.1.13",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vue-tsc": "^2.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "vue-demi"
    ]
  }
}
