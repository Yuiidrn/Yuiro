# 换行策略：仓库内部统一以 LF 存储；Windows（core.autocrlf=true）检出为 CRLF，
# macOS / Linux 检出为 LF。保证同一份代码两个平台都能跑。

* text=auto

# shell 脚本与 Python 必须是 LF —— CRLF 会让 shebang 变成 `#!/usr/bin/env bash\r`，
# 在 macOS 上直接报 "bad interpreter: No such file or directory"。
*.sh text eol=lf
*.py text eol=lf

# Windows 批处理保持 CRLF（cmd 对 LF 的容错较差）
*.bat text eol=crlf

# 二进制资源，禁止任何转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.wav binary
*.mp3 binary
*.mp4 binary
*.moc3 binary
*.onnx binary
*.ckpt binary
*.pth binary
*.db binary
*.woff2 binary
