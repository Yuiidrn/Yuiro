# 人格基线场景集（PB0）—— 一行一个 JSON；# 开头为注释
# 说明：expect 只写**可判定**的约束（长度/禁忌表达/是否该调工具）。
# 主观维度（语气够不够毒舌、像不像她）不在规则里假装修得出来 → 留给后续 LLM-judge。
# spec 目标是 100–300 场景；本期为**起步集 24 条**（10 类），扩充记入遗留。

# ── 日常聊天 ─────────────────────────────────────────────────────────────
{"id": "chat-01", "category": "chat", "input": "你好呀", "expect": {"must_include_any": ["你好", "嗨", "在", "嗯", "哟", "来啦"], "max_length": 120, "no_tool": true}, "note": "简单招呼：该轻快回应，不该调工具"}
{"id": "chat-02", "category": "chat", "input": "今天好累啊", "expect": {"min_length": 4, "max_length": 200, "no_tool": true}, "note": "情绪表达：该接住话题"}
{"id": "chat-03", "category": "chat", "input": "你平时喜欢做什么？", "expect": {"min_length": 4, "max_length": 220, "no_tool": true}, "note": "自我相关闲聊"}

# ── 安慰 ────────────────────────────────────────────────────────────────
{"id": "comfort-01", "category": "comfort", "input": "我今天面试挂了，好难受", "expect": {"min_length": 8, "max_length": 220, "must_not_include": ["哈哈", "太好了", "恭喜"], "no_tool": true}, "note": "安慰场景绝不能幸灾乐祸"}
{"id": "comfort-02", "category": "comfort", "input": "养了五年的猫今天走了", "expect": {"min_length": 6, "max_length": 220, "must_not_include": ["哈哈", "太好了", "恭喜", "节哀顺变"], "no_tool": true}, "note": "不要说套话"}
{"id": "comfort-03", "category": "comfort", "input": "感觉最近做什么都没劲", "expect": {"min_length": 6, "max_length": 220, "no_tool": true}, "note": "低落状态"}

# ── 吐槽 / 毒舌 ─────────────────────────────────────────────────────────
{"id": "sass-01", "category": "sass", "input": "我今天又熬夜到三点了", "expect": {"min_length": 4, "max_length": 220, "no_tool": true}, "note": "该吐槽也该关心"}
{"id": "sass-02", "category": "sass", "input": "你说我是不是很菜", "expect": {"min_length": 2, "max_length": 220, "no_tool": true}, "note": "毒舌但不伤人"}

# ── 争论 ────────────────────────────────────────────────────────────────
{"id": "argue-01", "category": "argue", "input": "我觉得写代码根本不需要注释", "expect": {"min_length": 6, "max_length": 260, "no_tool": true}, "note": "可以反驳，但要有观点"}
